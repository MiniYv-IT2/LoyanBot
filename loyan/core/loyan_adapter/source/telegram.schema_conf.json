{
  "token": {
    "type": "str",
    "default": "",
    "description": "Bot Token",
    "required": true,
    "secret": true
  },
  "proxy_url": {
    "type": "str",
    "default": "",
    "description": "代理地址（可选）"
  },
  "webhook_url": {
    "type": "str",
