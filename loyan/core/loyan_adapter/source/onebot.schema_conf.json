{
  "type": {
    "type": "str",
    "default": "ws_reverse",
    "description": "连接类型（ws_forward / ws_reverse / http）",
    "required": true
  },
  "host": {
    "type": "str",
    "default": "127.0.0.1",
    "description": "服务地址",
    "required": true
  },
  "port": {
    "type": "int",
    "default": 8080,
    "description": "服务端口",
    "required": true
  },
  "access_token": {
    "type": "str",
    "default": "",
    "description": "access_token（可选）",
    "secret": true
  },
  "robot_id": {
    "type": "str",
    "default": "",
    "description": "机器人 ID"
  },
  "callback_port": {
    "type": "int",
    "default": 3002,
    "description": "HTTP 回调端口（HTTP 模式用）",
    "showWhen": {
      "field": "type",
      "value": "http"
    }
  },
  "token": {
    "type": "str",
    "default": "",
    "description": "Token",
    "secret": true
  },
  "admins_id": {
    "type": "list",
    "default": [],
    "description": "管理员 ID 列表",
    "hint": "多个用逗号分隔",
    "required": true
  },
  "bot_name": {
    "type": "str",
    "default": "",
    "description": "备注名称",
    "required": true
  }
}